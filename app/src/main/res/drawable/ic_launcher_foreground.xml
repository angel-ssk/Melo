<?xml version="1.0" encoding="utf-8"?>
<!-- Supplied Melo M mark, explicitly sized into the adaptive-icon safe zone
     so launchers never scale it up and crop the artwork. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/melo_mark"
            android:gravity="fill" />
    </item>
</layer-list>
